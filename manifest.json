{
  "manifest_version": 3,
  "name": "Banish",
  "version": "1.3",
  "description": "Cierra automáticamente modales de newsletter, 'inicia sesión para continuar' y otros overlays molestos en los sitios que tú definas.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Banish"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib.js", "selector.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
